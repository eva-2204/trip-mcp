# Секрет: ключ OpenRouter (обязателен для запуска AI-агента)
OPENROUTER_API_KEY=

# Порт HTTP-сервера (необязательно)
PORT=3000

# Адреса MCP-серверов (необязательно, значения по умолчанию указаны ниже)
KIWI_MCP_URL=https://mcp.kiwi.com
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp

# Базовый URL и модель OpenRouter (необязательно)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
