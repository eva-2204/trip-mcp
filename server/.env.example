# Обязательно: ключ OpenRouter API — без него агент не будет отвечать.
OPENROUTER_API_KEY=

# Необязательно: базовый URL OpenRouter (OpenAI-совместимый Chat Completions API).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Необязательно: модель, используемая агентом. По умолчанию 'openrouter/free' —
# роутер сам выбирает бесплатную модель с поддержкой tool calling.
OPENROUTER_MODEL=openrouter/free

# Необязательно: порт, на котором слушает сервер.
PORT=8787

# Необязательно: адреса MCP-серверов (по умолчанию указаны официальные).
KIWI_MCP_URL=https://mcp.kiwi.com
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp
