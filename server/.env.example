# Обязательно: ключ Anthropic API — без него агент не будет отвечать.
ANTHROPIC_API_KEY=

# Необязательно: модель Claude, используемая агентом (по умолчанию claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# Необязательно: порт, на котором слушает сервер.
PORT=8787

# Необязательно: адреса MCP-серверов (по умолчанию указаны официальные).
KIWI_MCP_URL=https://mcp.kiwi.com
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp
